    "@toruslabs/base-controllers": "^10.0.0",
    "@toruslabs/ethereum-controllers": "^10.0.0",
    "@toruslabs/solana-controllers": "^10.0.0",
    "@toruslabs/vue-components": "^9.0.1",
    "@toruslabs/vue-icons": "^9.0.0",
    "@wagmi/vue": "^0.5.30",
    "@web3auth/auth": "^12.0.0",
    "@web3auth/modal": "file:../../packages/modal",
    "@web3auth/no-modal": "file:../../packages/no-modal",
    "@web3auth/sign-in-with-web3": "^6.2.0",
    "@web3auth/ws-embed": "^6.1.0",
    "viem": "^2.52.0",
    "ox": "^0.14.27",
    "petite-vue-i18n": "^11.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vue": "^3.5.35"
  },
  "overrides": {
