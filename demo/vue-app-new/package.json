  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@toruslabs/oxlint-config-react": "^1.0.0",
    "@toruslabs/oxlint-config-vue": "^1.0.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "globals": "^17.6.0",
    "oxlint-plugin-vize": "^0.608.0",
    "oxlint-tailwindcss": "^1.17.1",
    "postcss": "^8.5.15",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "vite-plus": "1.5.0",
    "vue-tsc": "^3.3.3"
