{
  "author": "Torus Labs",
  "bugs": {
    "url": "https://github.com/Web3Auth/Web3Auth/issues"
  },
  "description": "Monorepo for web3 auth packages",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@solana/kit": "^6.9.0",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-node": "^1.0.0",
    "@toruslabs/oxlint-config-react": "^1.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/oxlint-config-vue": "^1.0.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ox": "^0.11.3",
    "oxlint-plugin-vize": "^0.608.0",
    "oxlint-tailwindcss": "^1.17.1",
    "playwright": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "homepage": "https://github.com/Web3Auth/Web3Auth#readme",
  "keywords": [
    "aggregator",
    "authentication",
    "blockchain",
    "ethereum",
    "key management",
    "login",
    "solana",
    "wallet",
    "web3"
  ],
  "license": "ISC",
  "lint-staged": {
    "*": ["vp fmt", "vp lint --fix"]
  },
  "name": "web3auth",
  "optionalDependencies": {
    "@nx/nx-linux-x64-gnu": "^22.7.5",
    "@rollup/rollup-linux-x64-gnu": "^4.61.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Web3Auth/Web3Auth.git"
  },
  "scripts": {
    "build": "vp run -r --fail-if-no-match build",
    "clean": "rimraf packages/*/dist packages/*/*.tgz .eslintcache",
    "dev": "vp run -r --fail-if-no-match dev",
    "lint": "vp check && node scripts/lint-vue-templates.mjs",
    "locale": "node locales/importLocales.mjs",
    "pack": "vp run -r --fail-if-no-match pack",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "release-packages": "changeset publish",
    "test": "vp run -r --fail-if-no-match test",
    "typecheck": "tsc -p packages/no-modal --noEmit && tsc -p packages/modal --noEmit",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "workspaces": [
    "packages/no-modal",
    "packages/modal"
  ],
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  }
}
